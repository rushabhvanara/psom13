    $("liveHour").textContent =
        String(hour).padStart(2,"0")+
        ":00";


    $("livePV").textContent =
        num(x.pv)+" kW";

    $("liveWind").textContent =
        num(x.wind)+" kW";

    $("liveLoad").textContent =
        num(x.load)+" kW";

    $("liveGrid").textContent =
        num(x.grid)+" kW";


    $("batLivePower").textContent =
        num(x.battery)+" kW";


    $("socBig").textContent =
        num(x.soc)+"%";


    $("socBar").style.width =
        x.soc+"%";


    $("batEnergy").textContent =
        num(
            x.soc/100*
            Number($("bat").value)
        )+
        " kWh";


    $("pvSVG").textContent =
        num(x.pv)+" kW";

    $("windSVG").textContent =
        num(x.wind)+" kW";

    $("gridSVG").textContent =
        num(x.grid)+" kW";

    $("loadSVG").textContent =
        num(x.load)+" kW";


    updateBatteryGraphic(
        x.soc
    );


    $("renewPower").textContent =
        num(
            x.pv+x.wind
        )+
        " kW";


    $("loadPower").textContent =
        num(
            x.load
        )+
        " kW";


    $("svgRenewable").textContent =
        num(
            x.pv+x.wind
        )+
        " kW";


    /* Battery state */

    if(x.battery < -0.1){

        $("batteryState").textContent =
            "CHARGING";

    }else if(x.battery > 0.1){

        $("batteryState").textContent =
            "DISCHARGING";

    }else{

        $("batteryState").textContent =
            "STANDBY";

    }


    /* Operating message */

    if(x.grid > 0){

        $("liveMessage").textContent =
            "Utility grid is supplying the remaining load demand.";

        $("liveMessage").className =
            "alert alert-warning";

    }else if(x.grid < 0){

        $("liveMessage").textContent =
            "Renewable surplus is being exported to the utility grid.";

        $("liveMessage").className =
            "alert alert-ok";

    }else{

        $("liveMessage").textContent =
            "Local renewable generation and battery storage are balancing the load.";

        $("liveMessage").className =
            "alert alert-ok";

    }

}


/* =========================================================
   STOP ANIMATION
========================================================= */

function stopAnimation(){

    if(animationTimer){

        clearInterval(
            animationTimer
        );

        animationTimer = null;

    }

}


/* =========================================================
   FAULT CONTROL
========================================================= */

function toggleFault(type){

    faults[type] =
        !faults[type];


    const buttonMap = {

        pv:"pvFaultBtn",
        wind:"windFaultBtn",
        battery:"batFaultBtn",
        grid:"gridFaultBtn"

    };


    const button =
        $(buttonMap[type]);


    if(faults[type]){

        button.textContent =
            "FAULT";

        button.classList.add(
            "danger"
        );

    }else{

        button.textContent =
            "NORMAL";

        button.classList.remove(
            "danger"
        );

    }


    updateFaultMessage();

    simulate();

}


/* =========================================================
   FAULT MESSAGE
========================================================= */

function updateFaultMessage(){

    const active =
        Object.keys(faults)
        .filter(
            key=>faults[key]
        );


    if(active.length===0){

        $("faultMessage").textContent =
            "No faults applied.";

        $("faultMessage").className =
            "alert alert-ok";

        return;

    }


    $("faultMessage").textContent =
        "Active contingency: "+
        active.join(", ")
        .toUpperCase()+
        ". The 24-hour simulation has been recalculated.";

    $("faultMessage").className =
        "alert alert-warning";

}


