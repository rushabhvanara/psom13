<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Virtual Lab | Renewable Energy Microgrid & Battery Energy Storage</title>

<style>
/* =========================================================
   GLOBAL
========================================================= */

:root{
    --bg:#06111b;
    --bg2:#091927;
    --panel:#0b1a28;
    --panel2:#0e2132;
    --border:#284357;
    --text:#e8f3f8;
    --muted:#8da5b5;

    --pv:#ffd34d;
    --wind:#4da6ff;
    --battery:#36df7d;
    --grid:#ad82ff;
    --load:#ff6262;
    --cyan:#20d8ff;
    --orange:#ff9d43;

    --shadow:0 15px 40px rgba(0,0,0,.28);
}

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    background:
        radial-gradient(circle at 15% 5%,rgba(32,216,255,.07),transparent 28%),
        radial-gradient(circle at 85% 25%,rgba(54,223,125,.045),transparent 25%),
        var(--bg);
    color:var(--text);
    font-family:Inter,Segoe UI,Roboto,Arial,sans-serif;
}

a{
    color:inherit;
}

/* =========================================================
   HEADER
========================================================= */

header{
    padding:26px 4vw 25px;
    border-bottom:1px solid var(--border);
    background:linear-gradient(180deg,#071826,#08131f);
    position:relative;
}

.home-link{
    position:absolute;
    top:17px;
    left:22px;
    text-decoration:none;
    font-size:12px;
    color:var(--cyan);
    border:1px solid #28566e;
    background:#0a1d2c;
    border-radius:7px;
    padding:8px 14px;
    transition:.2s;
}

.home-link:hover{
    background:#10364d;
}

.header-inner{
    width:min(1400px,94%);
    margin:auto;
    padding-top:24px;
}

.eyebrow{
    color:var(--cyan);
    text-transform:uppercase;
    letter-spacing:2px;
    font-size:11px;
    font-weight:800;
}

h1{
    margin:8px 0 9px;
    font-size:clamp(26px,3.6vw,44px);
    line-height:1.1;
}

.subtitle{
    margin:0;
    max-width:1050px;
    color:var(--muted);
    font-size:14px;
    line-height:1.6;
}

/* =========================================================
   LAYOUT
========================================================= */

.container{
    width:min(1400px,94%);
    margin:20px auto;
}

.section{
    background:rgba(11,26,40,.96);
    border:1px solid var(--border);
    border-radius:12px;
    margin-bottom:18px;
    box-shadow:var(--shadow);
    overflow:hidden;
}

.section-header{
    padding:14px 18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:12px;
    border-bottom:1px solid var(--border);
}

.section-header h2{
    margin:0;
    font-size:16px;
}

.section-content{
    padding:18px;
}

.badge{
    display:inline-block;
    padding:5px 9px;
    border-radius:20px;
    border:1px solid var(--border);
    color:var(--muted);
    font-size:10px;
    white-space:nowrap;
}

/* =========================================================
   KPI
========================================================= */

.kpi-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

@media(max-width:800px){
    .kpi-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:500px){
    .kpi-grid{
        grid-template-columns:1fr;
    }
}

.kpi{
    background:#081724;
    border:1px solid var(--border);
    border-radius:9px;
    padding:12px;
}

.kpi-label{
    color:var(--muted);
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:.7px;
}

.kpi-value{
    margin-top:4px;
    font-size:21px;
    font-weight:850;
}

.cyan{color:var(--cyan)}
.green{color:var(--battery)}
.yellow{color:var(--pv)}
.blue{color:var(--wind)}
.red{color:var(--load)}
.purple{color:var(--grid)}
.orange{color:var(--orange)}

/* =========================================================
   STATUS
========================================================= */

.status{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:11px;
    color:var(--muted);
}

.status-dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:var(--battery);
    box-shadow:0 0 14px var(--battery);
}

/* =========================================================
   MICROGRID SVG
========================================================= */

.diagram-wrapper{
    width:100%;
    overflow-x:auto;
    background:
        linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
    background-size:25px 25px;
    border:1px solid var(--border);
    border-radius:10px;
}

.microgrid{
    display:block;
    width:1400px;
    height:720px;
    min-width:1400px;
}

/* SVG typography */

.svg-title{
    fill:#eaf7fb;
    font-size:21px;
    font-weight:900;
    letter-spacing:.6px;
}

.svg-subtitle{
    fill:#718b9d;
    font-size:11px;
}

.device-box{
    fill:#091a29;
    stroke:#35536a;
    stroke-width:2;
}

.device-box:hover{
    stroke:#5c7d92;
}

.device-title{
    fill:#edf8fc;
    font-size:15px;
    font-weight:850;
}

.device-sub{
    fill:#8199a9;
    font-size:10.5px;
}

.device-value{
    font-size:12px;
    font-weight:850;
}

.busbar{
    stroke:#e7f3f7;
    stroke-width:9;
    stroke-linecap:round;
}

.busbar-label{
    fill:#a7bdca;
    font-size:11px;
    font-weight:800;
}

.wire{
    fill:none;
    stroke-width:3.5;
    stroke-linecap:round;
    stroke-linejoin:round;
}

.power-flow{
    stroke-dasharray:11 9;
    animation:dashFlow 1s linear infinite;
}

@keyframes dashFlow{
    to{
        stroke-dashoffset:-20;
    }
}

.flow-label{
    font-size:10px;
    font-weight:800;
}

.measurement{
    fill:#0b2433;
    stroke:#315c72;
    stroke-width:1;
}

.measurement-text{
    fill:#9bc1d2;
    font-size:9.5px;
    font-weight:700;
}

/* =========================================================
   CONTROLS
========================================================= */

.controls{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
    gap:12px;
}

.control{
    background:#081724;
    border:1px solid var(--border);
    border-radius:9px;
    padding:12px;
}

.control label{
    display:flex;
    justify-content:space-between;
    gap:8px;
    margin-bottom:8px;
    font-size:12px;
    font-weight:750;
}

.control-value{
    color:var(--cyan);
}

input[type=range]{
    width:100%;
    accent-color:var(--cyan);
}

select{
    width:100%;
    padding:9px;
    color:var(--text);
    background:#071522;
    border:1px solid var(--border);
    border-radius:6px;
}

button{
    border:1px solid #2b6178;
    color:#e5f8ff;
    background:#0b3348;
    border-radius:7px;
    padding:9px 14px;
    cursor:pointer;
    font-weight:800;
    font-size:11px;
}

button:hover{
    background:#104c68;
}

button.primary{
    background:#08637e;
    border-color:#1697bd;
}

button.success{
    background:#105c3a;
    border-color:#23965d;
}

button.danger{
    background:#602a31;
    border-color:#a4434e;
}

.button-row{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-top:15px;
}

/* =========================================================
   GRID LAYOUT
========================================================= */

.dashboard{
    display:grid;
    grid-template-columns:repeat(12,1fr);
    gap:15px;
}

.c3{grid-column:span 3}
.c4{grid-column:span 4}
.c6{grid-column:span 6}
.c8{grid-column:span 8}
.c12{grid-column:span 12}

@media(max-width:950px){
    .c3,.c4,.c6,.c8{
        grid-column:span 12;
    }
}

/* =========================================================
   BATTERY
========================================================= */

.soc-number{
    text-align:center;
    font-size:43px;
    font-weight:900;
    color:var(--battery);
    margin:5px 0 10px;
}

.progress{
    height:18px;
    background:#142736;
    border:1px solid #2a4356;
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    height:100%;
    width:55%;
    background:linear-gradient(90deg,#ff5d5d,#ffd04d,#36df7d);
    transition:.3s;
}

.center-text{
    text-align:center;
}

.small{
    color:var(--muted);
    font-size:11px;
}

/* =========================================================
   CHARTS
========================================================= */

canvas{
    width:100%;
    height:320px;
    display:block;
    background:#071521;
    border:1px solid var(--border);
    border-radius:9px;
}

.chart-small{
    height:280px;
}

/* =========================================================
   EQUATIONS
========================================================= */

.equation{
    padding:14px;
    margin:10px 0 15px;
    background:#071521;
    border:1px solid var(--border);
    border-left:4px solid var(--cyan);
    border-radius:7px;
    overflow:auto;
}

.note{
    background:#092032;
    border:1px solid #25516a;
    border-radius:8px;
    padding:12px;
    color:#b6cbd6;
    font-size:13px;
    line-height:1.65;
}

.alert{
    padding:11px 13px;
    border-radius:7px;
    font-size:12px;
    font-weight:700;
}

.alert-ok{
    color:#6cf0a2;
    background:#0b3020;
    border:1px solid #1c7549;
}

.alert-warning{
    color:#ffd46a;
    background:#382b0c;
    border:1px solid #715a1c;
}

.alert-danger{
    color:#ff9999;
    background:#3b171b;
    border:1px solid #7a3038;
}

/* =========================================================
   TABLE
========================================================= */

.table-wrap{
    max-height:390px;
    overflow:auto;
    border:1px solid var(--border);
    border-radius:8px;
}

table{
    width:100%;
    border-collapse:collapse;
    font-size:11px;
}

th,td{
    padding:8px;
    border-bottom:1px solid #203648;
    text-align:right;
    white-space:nowrap;
}

th:first-child,
td:first-child{
    text-align:left;
}

th{
    background:#091a28;
    color:#a9c0ce;
    position:sticky;
    top:0;
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    margin-top:25px;
    padding:27px;
    border-top:1px solid var(--border);
    text-align:center;
    color:#8da4b3;
    font-size:12px;
    line-height:1.8;
}

footer strong{
    color:#fff;
}
</style>
</head>

