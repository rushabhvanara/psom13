/* =========================================================
   INTERPRETATION
========================================================= */

function updateInterpretation(){

    const r =
        window.results;


    const maximumPV =
        Math.max(
            ...data.map(
                x=>x.pv
            )
        );


    const maximumWind =
        Math.max(
            ...data.map(
                x=>x.wind
            )
        );


    const minimumSOC =
        Math.min(
            ...data.map(
                x=>x.soc
            )
        );


    const maximumSOC =
        Math.max(
            ...data.map(
                x=>x.soc
            )
        );


    const chargingHours =
        data.filter(
            x=>x.battery<-.1
        ).length;


    const dischargingHours =
        data.filter(
            x=>x.battery>.1
        ).length;


    let conclusion;


    if(
        r.penetration >= 100
    ){

        conclusion =
            "The renewable generation capacity is sufficient to produce daily energy equal to or greater than the simulated electrical demand.";

    }else{

        conclusion =
            "Increasing renewable capacity and/or battery storage can further reduce utility-grid dependence.";

    }


    $("interpretation").innerHTML = `

    <strong>Calculated engineering interpretation</strong>

    <ul>

    <li>
    Daily PV energy:
    <strong>${num(r.pvEnergy)} kWh</strong>
    </li>

    <li>
    Daily wind energy:
    <strong>${num(r.windEnergy)} kWh</strong>
    </li>

    <li>
    Total renewable energy:
    <strong>${num(r.renewableEnergy)} kWh</strong>
    </li>

    <li>
    Daily load energy:
    <strong>${num(r.loadEnergy)} kWh</strong>
    </li>

    <li>
    Maximum PV power:
    <strong>${num(maximumPV)} kW</strong>
    </li>

    <li>
    Maximum wind power:
    <strong>${num(maximumWind)} kW</strong>
    </li>

    <li>
    Battery SOC range:
    <strong>${num(minimumSOC)}–${num(maximumSOC)}%</strong>
    </li>

    <li>
    Battery charging duration:
    <strong>${chargingHours} h</strong>
    </li>

    <li>
    Battery discharging duration:
    <strong>${dischargingHours} h</strong>
    </li>

    <li>
    Utility import:
    <strong>${num(r.gridImport)} kWh</strong>
    </li>

    <li>
    Utility export:
    <strong>${num(r.gridExport)} kWh</strong>
    </li>

    <li>
    Renewable penetration:
    <strong>${num(r.penetration)}%</strong>
    </li>

    <li>
    Load self-sufficiency:
    <strong>${num(r.selfSufficiency)}%</strong>
    </li>

    </ul>

    <strong>Conclusion:</strong>
    ${conclusion}

    `;

}


/* =========================================================
   LIVE ANIMATION
========================================================= */

function animateSimulation(){

    if(!data.length){
        simulate();
    }


    stopAnimation();


    let hour = 0;


    animationTimer =
        setInterval(()=>{

            showHour(hour);

            hour++;


            if(hour >= 24){

                stopAnimation();

            }

        },700);

}


