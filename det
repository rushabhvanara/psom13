<script>

/* =========================================================
   MICROGRID SIMULATION ENGINE
========================================================= */

const $ = id => document.getElementById(id);

let data = [];
let animationTimer = null;

const faults = {
    pv:false,
    wind:false,
    battery:false,
    grid:false
};


/* =========================================================
   CONTROL DISPLAY
========================================================= */

const controls = [

    ["pv","pvV"," kW"],
    ["wind","windV"," kW"],
    ["bat","batV"," kWh"],
    ["batPower","batPowerV"," kW"],
    ["soc","socV","%"],
    ["load","loadV"," kW"],
    ["etaC","etaCV","%"],
    ["etaD","etaDV","%"]

];

controls.forEach(c => {

    $(c[0]).addEventListener("input",function(){

        $(c[1]).textContent =
            this.value + c[2];

    });

});


/* =========================================================
   SOLAR IRRADIANCE MODEL
========================================================= */

function irradiance(hour){

    if(hour < 6 || hour > 18){
        return 0;
    }

    const x =
        (hour - 6) / 12;

    let G =
        Math.sin(Math.PI*x);

    G *=
        0.94 +
        0.045*Math.sin(hour*1.73) +
        0.025*Math.cos(hour*3.7);

    return Math.max(
        0,
        Math.min(1,G)
    );
}


/* =========================================================
   WIND SPEED MODEL
========================================================= */

function windSpeed(hour){

    return Math.max(
        3.2,

        8 +

        1.8*Math.sin(
            (hour+1)*Math.PI/12
        ) +

        1.25*Math.sin(hour*1.7) +

        0.6*Math.cos(hour*.83)
    );

}


/* =========================================================
   WIND TURBINE MODEL
========================================================= */

function windPower(v,rated){

    const vci = 3;
    const vr = 12;
    const vco = 25;

    if(v < vci || v >= vco){
        return 0;
    }

    if(v < vr){

        const x =
            (v-vci)/
            (vr-vci);

        return rated*
               x*x*x*
               0.95;
    }

    return rated*0.95;
}


/* =========================================================
   LOAD PROFILE
========================================================= */

function loadProfile(hour,base){

    let factor = 0.9;

    if(hour < 6){

        factor = 0.68;

    }else if(hour < 9){

        factor = 1.00;

    }else if(hour < 16){

        factor = 0.83;

    }else if(hour < 21){

        factor = 1.38;

    }else{

        factor = 1.00;

    }

    return base*factor;
}


/* =========================================================
   SIMULATION
========================================================= */

function simulate(){

    stopAnimation();

    const pvRated =
        Number($("pv").value);

    const windRated =
        Number($("wind").value);

    const capacity =
        Number($("bat").value);

    const maxBatteryPower =
        Number($("batPower").value);

    const etaC =
        Number($("etaC").value)/100;

    const etaD =
        Number($("etaD").value)/100;

    const baseLoad =
        Number($("load").value);

    let batteryEnergy =
        capacity*
        Number($("soc").value)/100;

    data = [];

    let pvEnergy = 0;
    let windEnergy = 0;
    let loadEnergy = 0;

    let gridImport = 0;
    let gridExport = 0;

    let chargeEnergy = 0;
    let dischargeEnergy = 0;


    for(let hour=0;hour<24;hour++){

        const G =
            irradiance(hour);

        const v =
            windSpeed(hour);


        let pv =
            pvRated*
            G*
            0.96;

        let wind =
            windPower(
                v,
                windRated
            );


        if(faults.pv){
            pv = 0;
        }

        if(faults.wind){
            wind = 0;
        }


        const load =
            loadProfile(
                hour,
                baseLoad
            );


        const renewable =
            pv + wind;


        let batteryPower = 0;
        let gridPower = 0;


        /* =============================================
           RENEWABLE SURPLUS
        ============================================== */

        if(renewable >= load){

            const surplus =
                renewable-load;


            if(!faults.battery){

                const charge =
                    Math.min(

                        surplus,

                        maxBatteryPower,

                        (capacity-batteryEnergy)/
                        etaC

                    );


                if(charge > 0){

                    batteryPower =
                        -charge;

                    batteryEnergy +=
                        charge*etaC;

                    chargeEnergy +=
                        charge;
                }
            }


            const excess =
                surplus +
                batteryPower;


            if(faults.grid){

                gridPower = 0;

            }else{

                gridPower =
                    -Math.max(
                        0,
                        excess
                    );
            }


        }else{

            /* =========================================
               RENEWABLE DEFICIT
            ========================================== */

            const deficit =
                load-renewable;


            if(!faults.battery){

                const discharge =
                    Math.min(

                        deficit,

                        maxBatteryPower,

                        batteryEnergy*etaD

                    );


                if(discharge > 0){

                    batteryPower =
                        discharge;

                    batteryEnergy -=
                        discharge/etaD;

                    dischargeEnergy +=
                        discharge;
                }
            }


            const remaining =
                deficit -
                Math.max(
                    0,
                    batteryPower
                );


            if(faults.grid){

                gridPower = 0;

            }else{

                gridPower =
                    remaining;
            }

        }


        batteryEnergy =
            Math.max(
                0,
                Math.min(
                    capacity,
                    batteryEnergy
                )
            );


        if(gridPower > 0){
            gridImport += gridPower;
        }

        if(gridPower < 0){
            gridExport += -gridPower;
        }


        pvEnergy += pv;
        windEnergy += wind;
        loadEnergy += load;


        data.push({

            hour,

            irradiance:G,

            windSpeed:v,

            pv,

            wind,

            load,

            battery:batteryPower,

            soc:
                100*
                batteryEnergy/
                capacity,

            grid:gridPower

        });

    }


    const renewableEnergy =
        pvEnergy +
        windEnergy;


    const penetration =
        renewableEnergy/
        loadEnergy*100;


    const selfSufficiency =
        Math.max(
            0,
            (1-gridImport/loadEnergy)*100
        );


    window.results = {

        pvEnergy,
        windEnergy,
        renewableEnergy,

        loadEnergy,

        gridImport,
        gridExport,

        chargeEnergy,
        dischargeEnergy,

        penetration,
        selfSufficiency,

        finalSOC:
            data[23].soc

    };


    updateResults();

    updateTable();

    updateInterpretation();

    drawCharts();

    updateSVG();

    $("systemStatus").textContent =
        "SIMULATION COMPLETE";

    $("flowBadge").textContent =
        "24-HOUR SIMULATION";

}


