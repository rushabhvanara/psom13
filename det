/* =========================================================
   CANVAS SETUP
========================================================= */

function canvasSetup(id){

    const canvas =
        $(id);

    const rect =
        canvas.getBoundingClientRect();

    const dpr =
        window.devicePixelRatio ||
        1;


    canvas.width =
        rect.width*dpr;

    canvas.height =
        rect.height*dpr;


    const ctx =
        canvas.getContext("2d");

    ctx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );


    return {

        ctx,

        W:rect.width,

        H:rect.height

    };

}


/* =========================================================
   GENERIC CHART
========================================================= */

function drawChart(
    canvasID,
    series,
    yLabel,
    zero=false
){

    const c =
        canvasSetup(
            canvasID
        );


    const ctx =
        c.ctx;

    const W =
        c.W;

    const H =
        c.H;


    ctx.clearRect(
        0,
        0,
        W,
        H
    );


    const L = 55;
    const R = 18;
    const T = 35;
    const B = 42;


    const plotW =
        W-L-R;

    const plotH =
        H-T-B;


    let values = [];

    series.forEach(
        s =>
            values.push(
                ...s.values
            )
    );


    let min =
        Math.min(...values);

    let max =
        Math.max(...values);


    if(zero){

        min =
            Math.min(
                0,
                min
            );

        max =
            Math.max(
                0,
                max
            );

    }


    if(min===max){

        min -= 1;
        max += 1;

    }


    const range =
        max-min;


    min -= range*.08;
    max += range*.08;


    /* GRID */

    ctx.font =
        "10px Segoe UI";


    for(let i=0;i<=5;i++){

        const y =
            T+
            plotH*i/5;


        ctx.strokeStyle =
            "#1a3040";

        ctx.lineWidth = 1;


        ctx.beginPath();

        ctx.moveTo(
            L,
            y
        );

        ctx.lineTo(
            L+plotW,
            y
        );

        ctx.stroke();


        const value =
            max-
            (max-min)*i/5;


        ctx.fillStyle =
            "#78909e";

        ctx.textAlign =
            "right";


        ctx.fillText(
            value.toFixed(0),
            L-7,
            y+4
        );

    }


    /* AXES */

    ctx.strokeStyle =
        "#718997";

    ctx.lineWidth =
        1.2;


    ctx.beginPath();

    ctx.moveTo(
        L,
        T
    );

    ctx.lineTo(
        L,
        T+plotH
    );

    ctx.lineTo(
        L+plotW,
        T+plotH
    );

    ctx.stroke();


    /* ZERO LINE */

    if(
        zero &&
        min<0 &&
        max>0
    ){

        const zy =
            T+
            plotH*
            max/
            (max-min);


        ctx.strokeStyle =
            "#526b7b";

        ctx.setLineDash(
            [5,5]
        );


        ctx.beginPath();

        ctx.moveTo(
            L,
            zy
        );

        ctx.lineTo(
            L+plotW,
            zy
        );

        ctx.stroke();

        ctx.setLineDash([]);

    }


    /* X AXIS */

    ctx.fillStyle =
        "#78909e";

    ctx.textAlign =
        "center";


    for(
        let i=0;
        i<24;
        i+=3
    ){

        const x =
            L+
            plotW*
            i/
            23;


        ctx.fillText(

            String(i)
            .padStart(2,"0")+
            ":00",

            x,

            H-18

        );

    }


    /* Y LABEL */

    ctx.save();

    ctx.translate(
        14,
        H/2
    );

    ctx.rotate(
        -Math.PI/2
    );

    ctx.fillStyle =
        "#78909e";

    ctx.textAlign =
        "center";

    ctx.fillText(
        yLabel,
        0,
        0
    );

    ctx.restore();


    /* SERIES */

    series.forEach(s=>{

        ctx.strokeStyle =
            s.color;

        ctx.lineWidth =
            2.3;

        ctx.beginPath();


        s.values.forEach(
            (value,i)=>{

                const x =
                    L+
                    plotW*
                    i/
                    23;


                const y =
                    T+
                    plotH*
                    (max-value)/
                    (max-min);


                if(i===0){

                    ctx.moveTo(
                        x,
                        y
                    );

                }else{

                    ctx.lineTo(
                        x,
                        y
                    );

                }

            }
        );


        ctx.stroke();


        /* DATA MARKERS */

        ctx.fillStyle =
            s.color;


        s.values.forEach(
            (value,i)=>{

                const x =
                    L+
                    plotW*
                    i/
                    23;


                const y =
                    T+
                    plotH*
                    (max-value)/
                    (max-min);


                ctx.beginPath();

                ctx.arc(
                    x,
                    y,
                    2.2,
                    0,
                    Math.PI*2
                );

                ctx.fill();

            }
        );

    });


    /* LEGEND */

    let legendX =
        L;


    series.forEach(s=>{

        ctx.fillStyle =
            s.color;

        ctx.fillRect(
            legendX,
            11,
            9,
            9
        );


        ctx.fillStyle =
            "#b9cbd5";

        ctx.textAlign =
            "left";


        ctx.fillText(
            s.name,
            legendX+14,
            20
        );


        legendX +=
            20+
            ctx.measureText(
                s.name
            ).width;

    });

}


